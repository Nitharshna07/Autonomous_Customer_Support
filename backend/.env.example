DATABASE_URL=sqlite:///./support_copilot.db
SECRET_KEY=super-secret-key-change-in-production-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Options: template | ollama | anthropic | openai
LLM_PROVIDER=template

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic settings (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Threshold for auto-escalating when RAG confidence is low (0.0 to 1.0)
RAG_CONFIDENCE_THRESHOLD=0.15
